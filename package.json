{
	"name": "@catstral/levy-utils",
	"version": "1.1.0",
	"description": "Re-useable and common JS/TS utility functions",
	"license": "MIT",
	"contributors": [
		{
			"email": "levyvandervalk@gmail.com",
			"name": "Levy van der Valk"
		},
		{
			"email": "levypondman@live.nl",
			"name": "Levy Pondman"
		}
	],
	"keywords": [
		"javascript",
		"typescript",
		"util",
		"utils",
		"utility",
		"utilities"
	],
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		"types": "./dist/index.d.ts",
		"import": "./dist/index.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Catstral/levy-utils.git"
	},
	"scripts": {
		"build": "bun test && bun build ./lib/index.ts --check --outdir ./dist --minify && tsc --noEmit false --emitDeclarationOnly",
		"publish": "bun run build && npm publish",
		"tsc": "tsc --noEmit --diagnostics",
		"lint": "biome check . --formatter-enabled=true",
		"lint:apply": "biome check . --formatter-enabled=true --write",
		"lint:apply:unsafe": "biome check . --formatter-enabled=true --write --unsafe",
		"check": "bun tsc && bun lint"
	},
	"devDependencies": {
		"@types/bun": "1.4.3",
		"@biomejs/biome": "2.5.4",
		"@types/diff-match-patch": "^1.0.36",
		"typescript": "^7.0.0"
	},
	"dependencies": {
		"diff-match-patch": "^1.0.5"
	}
}
