{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"lib": ["ESNext", "DOM"],
		"moduleResolution": "bundler",
		"strict": true,
		"sourceMap": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"skipLibCheck": true,
		"noEmit": true,
		"paths": {
			"~/*": ["./lib/*"]
		},
		"declaration": true,
		"outDir": "./dist",
		"rootDir": "./lib"
	},
	"include": ["lib"],
	"exclude": ["**/*.test.ts"]
}
